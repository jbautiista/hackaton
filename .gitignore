# Ignore directories generated by Composer
/vendor/
/web/core/
/web/libraries/
/web/modules/contrib/
/web/themes/contrib/
/web/themes/custom/*/node_modules
/web/profiles/contrib/

# Ignore configuration files that may contain sensitive information.
/web/sites/*/settings.local.php
/web/sites/*/services*.yml
/web/sites/development.services.yml

# Ignore paths that contain user-generated content.
/web/sites/*/files
/web/sites/*/private

# Ignore files generated by PhpStorm
/.idea/
/.vscode/
/.env

# Ignore files and directories by front
/node_modules/
/themes/custom/**/package-lock.json
/themes/custom/**/styleguide/

#other files and folders
.DS_Store
nbproject
*.sql
*.sql.gz
*.bk
*.bak
*.log
*.log2
*.ini
*.gz
*.mysql
*.mysql.gz
/nbproject/private/

#ignore lando files
.editorconfig
.gitattributes

docker-compose.yml
traefik.yml
Makefile
docker.mk
